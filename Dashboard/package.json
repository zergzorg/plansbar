{
  "name": "plansbar-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "scan": "tsx src/server/cli.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "build": "npm run type-check && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^3.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
